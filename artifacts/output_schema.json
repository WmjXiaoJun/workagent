{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/workagent/output_schema.json",
  "title": "WorkAgent Outputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "currency", "direct_cost", "total_price", "confidence", "conclusion"],
  "properties": {
    "project": { "type": "string" },
    "currency": { "type": "string" },
    "direct_cost": { "type": "number", "description": "直接成本合计" },
    "overhead": { "type": "number" },
    "risk_buffer": { "type": "number" },
    "margin": { "type": "number" },
    "total_price": { "type": "number", "description": "建议报价" },
    "unit_price_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "amount": { "type": "number" },
          "share": { "type": "number" }
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["level", "basis"],
      "properties": {
        "level": { "type": "string", "enum": ["high", "medium", "low"] },
        "basis": { "type": "string" }
      }
    },
    "conclusion": { "type": "string", "description": "一句话结论，可直接进入 summary.md" },
    "risks": { "type": "array", "items": { "type": "string" } }
  }
}
