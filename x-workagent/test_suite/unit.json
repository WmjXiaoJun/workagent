{
  "schema": "workagent/test/1",
  "type": "unit",
  "goal": "单节点逻辑校验：每个计算步骤单独可验证",
  "cases": [
    {
      "id": "UT-001",
      "step": "compute_direct_cost",
      "given": { "line_items": [{ "quantity": 2, "unit_cost": 100 }] },
